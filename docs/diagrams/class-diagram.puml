@startuml
title Diagrama de clases - Gestor de Rutas Adaptable

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

package "plugin-api" {
    interface "Strategy<I, O>" as Strategy {
        +id(): String
        +supports(contexto: Context): boolean
        +execute(entrada: I): Result<O>
    }

    class Context <<record>> {
        +origen: String
        +destino: String
        +criterio: String
        +permitePesosNegativos: boolean
    }

    class "Result<T>" as Result <<record>> {
        +exitoso: boolean
        +valor: T
        +mensaje: String
        +tiempoEjecucionMs: long
    }
}

package "domain" {
    class Node {
        -id: String
        -name: String
        -latitude: double
        -longitude: double
        +hasCoordinates(): boolean
    }

    class Connection {
        -origen: Node
        -destino: Node
        -peso: double
    }

    class Graph {
        -nodes: Map<String, Node>
        -connections: List<Connection>
        +addNode(node: Node): void
        +addConnection(connection: Connection): void
        +getNode(id: String): Node
        +getNodes(): Map<String, Node>
        +getConnections(): List<Connection>
        +getOutgoingConnections(node: Node): List<Connection>
    }

    class Haversine <<utility>> {
        +calcularDistancia(a: Node, b: Node): double
    }

    Graph "1" o-- "*" Node
    Graph "1" o-- "*" Connection
    Connection --> "1" Node : origen
    Connection --> "1" Node : destino
    Haversine ..> Node
}

package "adaptive-core" {
    class AdaptiveEngine {
        -selector: StrategySelector
        -monitor: MetricsMonitor
        -administrador: AdaptationManager
        -historial: AdaptationHistory
        +ejecutar<I, O>(contexto: Context, entrada: I): Result<O>
        +obtenerHistorial(): AdaptationHistory
        +obtenerEjecuciones(): List<ExecutionRecord>
        -ejecutarEstrategia<I, O>(estrategia: Strategy<?, ?>, entrada: I): Result<O>
    }

    class StrategySelector {
        -registro: StrategyRegistry
        +seleccionar(contexto: Context): Strategy<?, ?>
        +seleccionar(contexto: Context, estrategiaExcluida: String): Strategy<?, ?>
        +seleccionarExcluyendo(contexto: Context, estrategiasExcluidas: Set<String>): Strategy<?, ?>
    }

    class StrategyRegistry {
        -estrategias: List<Strategy<?, ?>>
        +registrar(estrategia: Strategy<?, ?>): void
        +obtenerTodas(): List<Strategy<?, ?>>
        +buscarPorId(id: String): Strategy<?, ?>
    }

    class MetricsMonitor {
        -metricas: Map<String, StrategyMetrics>
        -ejecuciones: List<ExecutionRecord>
        +registrarResultado(estrategiaId: String, resultado: Result<?>): void
        +obtenerMetricas(id: String): StrategyMetrics
        +obtenerTodasLasMetricas(): Map<String, StrategyMetrics>
        +obtenerEjecuciones(): List<ExecutionRecord>
    }

    class StrategyMetrics {
        -totalEjecuciones: int
        -totalErrores: int
        -tiempoTotalMs: long
        +registrarEjecucion(resultado: Result<?>): void
        +obtenerTotalEjecuciones(): int
        +obtenerTotalErrores(): int
        +obtenerTiempoTotalMs(): long
        +obtenerTiempoPromedioMs(): double
    }

    class ExecutionRecord <<record>> {
        +estrategia: String
        +tiempoMs: long
        +exitoso: boolean
    }

    class AdaptationManager {
        -reglas: List<AdaptationRule>
        +agregarRegla(regla: AdaptationRule): void
        +debeCambiar(metricas: StrategyMetrics): boolean
        +obtenerMotivos(metricas: StrategyMetrics): List<String>
    }

    interface AdaptationRule {
        +debeCambiar(metricas: StrategyMetrics): boolean
        +obtenerMotivo(): String
    }

    class ExecutionTimeRule {
        -tiempoMaximoMs: double
        +ExecutionTimeRule(tiempoMaximoMs: double)
        +ExecutionTimeRule(configuracion: AdaptiveConfig)
        +debeCambiar(metricas: StrategyMetrics): boolean
        +obtenerMotivo(): String
    }

    class ErrorThresholdRule {
        -porcentajeMaximoErrores: double
        +ErrorThresholdRule(porcentajeMaximoErrores: double)
        +debeCambiar(metricas: StrategyMetrics): boolean
        +obtenerMotivo(): String
    }

    class AdaptationHistory {
        -decisiones: List<AdaptationDecision>
        +registrar(decision: AdaptationDecision): void
        +obtenerTodas(): List<AdaptationDecision>
        +limpiar(): void
    }

    class AdaptationDecision <<record>> {
        +estrategiaInicial: String
        +motivos: List<String>
        +estrategiaAlternativa: String
        +huboCambio(): boolean
    }

    class AdaptiveConfig {
        -tiempoMaximoMs: long
        -cambiarSiSuperaLimite: boolean
        -porcentajeMaximoErrores: double
        -cambiarSiSuperaErrores: boolean
        +getTiempoMaximoMs(): long
        +setTiempoMaximoMs(tiempoMaximoMs: long): void
        +isCambiarSiSuperaLimite(): boolean
        +setCambiarSiSuperaLimite(valor: boolean): void
        +getPorcentajeMaximoErrores(): double
        +setPorcentajeMaximoErrores(porcentaje: double): void
        +isCambiarSiSuperaErrores(): boolean
        +setCambiarSiSuperaErrores(valor: boolean): void
    }

    class AdaptiveConfigRoot {
        -adaptacion: AdaptiveConfig
        +getAdaptacion(): AdaptiveConfig
        +setAdaptacion(adaptacion: AdaptiveConfig): void
    }

    class AdaptiveConfigLoader {
        +cargar(): AdaptiveConfig
    }

    AdaptiveEngine --> StrategySelector
    AdaptiveEngine --> MetricsMonitor
    AdaptiveEngine --> AdaptationManager
    AdaptiveEngine --> AdaptationHistory

    StrategySelector --> StrategyRegistry
    StrategyRegistry o-- Strategy

    MetricsMonitor --> StrategyMetrics
    MetricsMonitor --> ExecutionRecord

    AdaptationManager o-- AdaptationRule
    ExecutionTimeRule ..|> AdaptationRule
    ErrorThresholdRule ..|> AdaptationRule
    ExecutionTimeRule --> AdaptiveConfig
    AdaptationHistory o-- AdaptationDecision
    AdaptiveConfigLoader ..> AdaptiveConfigRoot
    AdaptiveConfigRoot *-- AdaptiveConfig
}

package "plugins-java" {
    class DijkstraStrategy
    class AStarStrategy
    class Route <<record>> {
        +nodeIds: List<String>
        +totalWeight: double
    }
    class RouteRequest <<record>> {
        +graph: Graph
        +origenId: String
        +destinoId: String
    }

    DijkstraStrategy ..|> Strategy
    AStarStrategy ..|> Strategy
    DijkstraStrategy ..> RouteRequest
    DijkstraStrategy ..> Route
    AStarStrategy ..> RouteRequest
    AStarStrategy ..> Route
    AStarStrategy ..> Haversine
    RouteRequest --> Graph
}

package "plugins-scala" {
    class DijkstraScalaStrategy
    DijkstraScalaStrategy ..|> Strategy
    DijkstraScalaStrategy ..> RouteRequest
    DijkstraScalaStrategy ..> Route
}

package "persistence" {
    class DatabaseConnection {
        -URL: String
        -USUARIO: String
        -contrasena: String
        +conectar(): java.sql.Connection
    }

    class ExecutionRepository {
        -database: DatabaseConnection
        +ExecutionRepository(database: DatabaseConnection)
        +guardar(estrategia: String, tiempoMs: long, exitoso: boolean): void
        +listar(): List<String>
        +actualizar(id: int, estrategia: String, tiempoMs: long, exitoso: boolean): boolean
        +eliminar(id: int): boolean
    }

    class AdaptationDecisionRepository {
        -database: DatabaseConnection
        +AdaptationDecisionRepository(database: DatabaseConnection)
        +guardar(estrategiaInicial: String, estrategiaAlternativa: String, motivos: List<String>): void
    }

    ExecutionRepository --> DatabaseConnection
    AdaptationDecisionRepository --> DatabaseConnection
}

package "launcher" {
    class GestorRutasApp {
        +main(args: String[]): void
        -crearGrafo(): Graph
        -crearGrafoSinCoordenadas(): Graph
    }

    class EstrategiasConfiguracion {
        -DIJKSTRA: String {static}
        -ASTAR: String {static}
        -DIJKSTRA_SCALA: String {static}
        +crearRegistro(criterio: String): StrategyRegistry {static}
        -cargarEstrategia(nombreClase: String): Strategy<?, ?> {static}
    }

    class PruebaCrudPostgreSQL {
        +main(args: String[]): void
    }

    GestorRutasApp ..> EstrategiasConfiguracion
    GestorRutasApp ..> AdaptiveEngine
    GestorRutasApp ..> ExecutionRepository
    GestorRutasApp ..> AdaptationDecisionRepository
    EstrategiasConfiguracion ..> StrategyRegistry
    EstrategiasConfiguracion ..> AStarStrategy
    EstrategiasConfiguracion ..> DijkstraStrategy
    EstrategiasConfiguracion ..> DijkstraScalaStrategy
    PruebaCrudPostgreSQL ..> DatabaseConnection
    PruebaCrudPostgreSQL ..> ExecutionRepository
}

@enduml
